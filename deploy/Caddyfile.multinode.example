# XIASS active-active ingress example.
#
# This edge terminates both public names. Customer inference traffic uses
# configurable origin weights. Browser/control-plane traffic is also served by
# both XIASS instances, but receives a sticky origin cookie because Team and
# OAuth flows can keep short-lived process-local resources.
#
# Point the two upstreams at XIASS application port 8080 over WireGuard or an
# equivalent private network. This avoids an extra origin reverse-proxy hop.
# Firewall 8080 so only the edge/private network can reach it. Never expose
# PostgreSQL, Redis, or node SOCKS ports publicly.

# Replace these example names with the public names configured for your
# deployment. Both names may point at the same healthy origin pool.
api.example.com, api2.example.com {
	encode gzip

	@inference path \
 /v1 /v1/* \
 /v1beta /v1beta/* \
 /responses /responses/* \
 /alpha/search \
 /models \
 /messages/count_tokens \
 /backend-api/codex /backend-api/codex/* \
 /chat/completions \
 /embeddings \
 /images/* \
 /videos/* \
 /antigravity/*

	handle @inference {
		reverse_proxy http://10.200.0.2:8080 http://10.200.0.3:8080 {
			# Public ingress weights. They are intentionally independent from
			# XIASS account-node weights in the admin settings.
			lb_policy weighted_round_robin 5 1
			lb_try_duration 1s
			lb_try_interval 100ms
			health_uri /readyz
			health_interval 5s
			health_timeout 1s
			health_fails 2
			health_passes 2
			health_status 200
			fail_duration 10s
			max_fails 2
			transport http {
				dial_timeout 800ms
			}
		}
	}

	# Browser/control-plane requests are active-active too. The signed cookie
	# keeps a browser on one healthy origin and automatically remaps it when that
	# origin is unavailable. Set XIASS_LB_COOKIE_SECRET to a strong random value.
	handle {
		reverse_proxy http://10.200.0.2:8080 http://10.200.0.3:8080 {
			lb_policy cookie xiass_origin {$XIASS_LB_COOKIE_SECRET}
			lb_try_duration 1s
			lb_try_interval 100ms
			health_uri /readyz
			health_interval 5s
			health_timeout 1s
			health_fails 2
			health_passes 2
			health_status 200
			fail_duration 10s
			max_fails 2
			transport http {
				dial_timeout 800ms
			}
		}
	}
}

# Operational notes:
# - 5:1 above controls public requests received by each application origin.
# - execution_node_weights controls which node-owned account handles a new
#   session inside the highest account-priority tier. Do not assume the two
#   independent ratios must be equal.
# - Setting an execution-node weight to 0 drains new account placement on that
#   node. The same node may remain a healthy ingress and use another node's
#   account through its fixed private egress.
# - SSE and WebSocket connections remain on the selected origin for their
#   lifetime. Caddy preserves Upgrade automatically.
# - Connection failures before an upstream accepts a request may use the other
#   healthy origin. Do not configure retries for POST requests after a completed
#   round trip; replaying a model request can duplicate upstream work and cost.
# - One edge is still an ingress single point of failure. Production disaster
#   recovery requires a managed/global load balancer or two independently
#   available edges in front of these same origins.
